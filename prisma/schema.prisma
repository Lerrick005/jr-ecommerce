generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH / USERS
// ============================================================

enum UserRole {
  CUSTOMER
  MANAGER
  SUPER_ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  phone         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  disabled      Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  customer       CustomerProfile?
  manager        ManagerProfile?
  addresses      Address[]
  orders         Order[]
  reviews        Review[]
  wishlistItems  WishlistItem[]
  carts          Cart[]
  returns        ReturnRequest[]
  alterations    AlterationRequest[]
  stockAlerts    StockNotification[]
  auditEntries   AuditLog[]           @relation("ActorAudit")
  statusChanges  OrderStatusHistory[] @relation("ChangedBy")
  couponsCreated Coupon[]             @relation("CouponCreatedBy")

  @@index([role])
  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model CustomerProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  measurementsJson Json?
  acceptsMarketing Boolean  @default(false)
  loyaltyPoints    Int      @default(0)
  referralCode     String?  @unique
  referredByCode   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ManagerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// ADDRESSES / DELIVERY
// ============================================================

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String?
  fullName      String
  phone         String
  county        String
  town          String
  area          String?
  landmark      String?
  deliveryNotes String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model DeliveryZone {
  id               String   @id @default(cuid())
  name             String   @unique
  counties         String[]
  baseFeeCents     Int
  freeAboveCents   Int?
  estimatedDaysMin Int      @default(1)
  estimatedDaysMax Int      @default(3)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============================================================
// CATALOGUE
// ============================================================

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  imageUrl    String?
  parentId    String?
  position    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([active])
}

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  bannerUrl   String?
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products CollectionProduct[]

  @@index([active])
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model Product {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  description      String?   @db.Text
  categoryId       String
  brand            String?
  attributesJson   Json?
  basePriceCents   Int
  compareAtCents   Int?
  currency         String    @default("KES")
  active           Boolean   @default(true)
  featured         Boolean   @default(false)
  isDrop           Boolean   @default(false)
  dropStartsAt     DateTime?
  preorder         Boolean   @default(false)
  preorderShipDate DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  category    Category            @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  collections CollectionProduct[]
  reviews     Review[]
  orderItems  OrderItem[]
  cartItems   CartItem[]
  wishlisted  WishlistItem[]
  stockAlerts StockNotification[]

  @@index([categoryId, active])
  @@index([featured])
  @@index([deletedAt])
  @@index([name])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  colour    String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id         String    @id @default(cuid())
  productId  String
  sku        String    @unique
  size       String?
  colour     String?
  priceCents Int?
  stock      Int       @default(0)
  reserved   Int       @default(0)
  active     Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  stockAlerts StockNotification[]

  @@index([productId])
  @@index([sku])
  @@index([stock])
}

model SizeGuide {
  id         String   @id @default(cuid())
  categoryId String?  @unique
  chartJson  Json
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================================
// LOOKBOOKS
// ============================================================

model Lookbook {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  coverUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items LookbookItem[]
}

model LookbookItem {
  id           String @id @default(cuid())
  lookbookId   String
  imageUrl     String
  caption      String?
  hotspotsJson Json?
  position     Int    @default(0)

  lookbook Lookbook @relation(fields: [lookbookId], references: [id], onDelete: Cascade)

  @@index([lookbookId, position])
}

// ============================================================
// CART / WISHLIST
// ============================================================

model Cart {
  id         String   @id @default(cuid())
  userId     String?
  guestToken String?  @unique
  couponCode String?
  giftNote   String?
  giftWrap   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([productId])
  @@index([variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

// ============================================================
// ORDERS / PAYMENTS
// ============================================================

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PREPARATION
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
  RETURN_REQUESTED
  RETURNED
  EXCHANGED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  MPESA
  CARD
  CASH_ON_DELIVERY
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique
  userId              String?
  addressId           String?
  customerEmail       String
  customerName        String
  customerPhone       String
  addressSnapshotJson Json
  status              OrderStatus   @default(PENDING_PAYMENT)
  subtotalCents       Int
  deliveryFeeCents    Int           @default(0)
  discountCents       Int           @default(0)
  vatCents            Int           @default(0)
  totalCents          Int
  currency            String        @default("KES")
  couponCode          String?
  giftNote            String?
  giftWrap            Boolean       @default(false)
  paymentMethod       PaymentMethod?
  idempotencyKey      String?       @unique
  notes               String?
  cancelledAt         DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user          User?                @relation(fields: [userId], references: [id])
  address       Address?             @relation(fields: [addressId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]
  returns       ReturnRequest[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([customerEmail])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  variantId      String
  nameSnapshot   String
  sizeSnapshot   String?
  colourSnapshot String?
  imageSnapshot  String?
  priceCents     Int
  quantity       Int
  lineTotalCents Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?
  note        String?
  createdAt   DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation("ChangedBy", fields: [changedById], references: [id])

  @@index([orderId, createdAt])
}

model Payment {
  id                  String        @id @default(cuid())
  orderId             String
  method              PaymentMethod
  status              PaymentStatus @default(PENDING)
  amountCents         Int
  currency            String        @default("KES")
  providerRef         String?
  providerReceipt     String?
  providerPayloadJson Json?
  idempotencyKey      String?       @unique
  failureReason       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([providerRef])
}

// ============================================================
// RETURNS / ALTERATIONS
// ============================================================

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
}

enum ReturnType {
  REFUND
  EXCHANGE
}

model ReturnRequest {
  id                String       @id @default(cuid())
  orderId           String
  userId            String
  type              ReturnType
  reason            String
  photosJson        Json?
  status            ReturnStatus @default(REQUESTED)
  managerNote       String?
  exchangeVariantId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([status])
}

model AlterationRequest {
  id               String   @id @default(cuid())
  userId           String?
  name             String
  phone            String
  email            String?
  measurementsJson Json?
  notes            String?
  quotedCents      Int?
  convertedOrderId String?
  status           String   @default("REQUESTED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([status])
}

// ============================================================
// REVIEWS / COUPONS / STOCK / SETTINGS / PAGES / AUDIT
// ============================================================

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int
  title      String?
  body       String?  @db.Text
  photosJson Json?
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, approved])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  type           String
  valueCents     Int?
  percentOff     Int?
  minOrderCents  Int?
  maxRedemptions Int?
  redemptions    Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdBy User? @relation("CouponCreatedBy", fields: [createdById], references: [id])
}

model StockNotification {
  id         String    @id @default(cuid())
  variantId  String
  productId  String
  userId     String?
  email      String
  phone      String?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id])

  @@index([variantId, notifiedAt])
}

model Setting {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  bodyJson  Json
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  diffJson   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("ActorAudit", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}